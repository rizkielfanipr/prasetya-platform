{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write resources/js resources/css tests/js tests/e2e *.ts",
        "format:check": "prettier --check resources/js resources/css tests/js tests/e2e *.ts",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.12.0",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.0.0",
        "vitest": "^5.0.5",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.14"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "@fontsource-variable/raleway": "^5.3.0",
        "@inertiajs/vue3": "^3.10.0",
        "@lucide/vue": "^1.66.0",
        "@vueuse/core": "^15.0.0",
        "chart.js": "^4.6.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "reka-ui": "^2.11.0",
        "tailwind-merge": "^3.7.0",
        "vue": "^3.5.44",
        "vue-sonner": "^2.0.9"
    }
}
