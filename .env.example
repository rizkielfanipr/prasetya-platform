APP_NAME="Prasetya Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prasetya_platform
DB_USERNAME=root
DB_PASSWORD=

# Production: SESSION_SECURE_COOKIE=true (defaults to true when APP_ENV=production)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@prasetyawebworks.web.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Platform ---
BUSINESS_TIMEZONE=Asia/Jakarta
CORS_ALLOWED_ORIGINS=https://prasetyawebworks.web.id,https://satamu.prasetyawebworks.web.id,http://localhost:4321
ORDER_EXPIRY_HOURS=72
PAYMENT_EXPIRY_GRACE_MINUTES=15
RECONCILIATION_PENDING_MINUTES=120
RECONCILIATION_NO_ATTEMPT_MINUTES=30

# First Super Admin, read by the seeder. Use your own values; the seeder refuses an empty password.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Payment gateway ---
# fake: no network, for local work and tests. Refused when APP_ENV=production.
# doku: real adapter; needs the credentials below.
PAYMENT_GATEWAY=fake
DOKU_ENVIRONMENT=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Must equal the path of the Notification URL configured in DOKU Back Office.
DOKU_NOTIFICATION_PATH=/api/v1/webhooks/doku
# 0 = off. See docs/api/doku-contract.md before enabling.
DOKU_NOTIFICATION_MAX_AGE_SECONDS=0
DOKU_PAYMENT_DUE_MINUTES=60
DOKU_TIMEOUT_SECONDS=15
DOKU_CONNECT_TIMEOUT_SECONDS=5
DOKU_CONNECT_RETRIES=1
DOKU_CALLBACK_URL_WEBWORKS=https://prasetyawebworks.web.id/order/status/
DOKU_CALLBACK_URL_SATAMU=https://satamu.prasetyawebworks.web.id/order/status/
