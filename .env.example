APP_NAME="Prasetya Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prasetya_platform
DB_USERNAME=root
DB_PASSWORD=

# Production: SESSION_SECURE_COOKIE=true (defaults to true when APP_ENV=production)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Content Studio images (private disk only; see config/content.php).
CONTENT_DISK=local
# Content Studio AI copy drafts (docs/runbooks/content-studio-ai.md). none = off; fake = local demo, no cost;
# openai_compatible = DeepSeek, OpenAI, OpenRouter, ... Keep the key here only; never commit it.
CONTENT_TEXT_PROVIDER=none
CONTENT_TEXT_BASE_URL=
CONTENT_TEXT_MODEL=
CONTENT_TEXT_API_KEY=
# Web research (none | fake | tavily).
CONTENT_SEARCH_PROVIDER=none
CONTENT_SEARCH_API_KEY=
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@prasetyawebworks.web.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Platform ---
BUSINESS_TIMEZONE=Asia/Jakarta
# Exact origins, comma-separated. Local: Webworks on 4321, Satamu on 4322 (npm run dev -- --port 4322). Never add localhost in production.
CORS_ALLOWED_ORIGINS=https://prasetyawebworks.web.id,https://satamu.prasetyawebworks.web.id,http://localhost:4321,http://localhost:4322
ORDER_EXPIRY_HOURS=72
PAYMENT_EXPIRY_GRACE_MINUTES=15
RECONCILIATION_PENDING_MINUTES=120
RECONCILIATION_NO_ATTEMPT_MINUTES=30

# First Super Admin, read by the seeder. Use your own values; the seeder refuses an empty password.
ADMIN_NAME="Super Admin"
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Payment gateway ---
# fake: no network, for local work and tests, with a simulated pay page. Refused when APP_ENV=production.
# duitku: real adapter; needs the credentials below. See docs/api/duitku-contract.md.
PAYMENT_GATEWAY=fake
# Local trial: http://localhost:4321/order/status/ (Webworks), http://localhost:4322/order/status/ (Satamu)
PAYMENT_RETURN_URL_WEBWORKS=https://prasetyawebworks.web.id/order/status/
PAYMENT_RETURN_URL_SATAMU=https://satamu.prasetyawebworks.web.id/order/status/
PAYMENT_DUE_MINUTES=60

DUITKU_ENVIRONMENT=sandbox
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# Public HTTPS address of /api/v1/webhooks/duitku. Empty means APP_URL plus that path.
DUITKU_CALLBACK_URL=
# Empty shows every active method. A code such as SP, NQ, or SQ limits checkout to that QRIS channel.
DUITKU_PAYMENT_METHOD=
DUITKU_ENFORCE_CALLBACK_IP=true
DUITKU_TIMEOUT_SECONDS=15
DUITKU_CONNECT_TIMEOUT_SECONDS=5
DUITKU_CONNECT_RETRIES=1

