<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The whole suite plus the architecture scan needs more than PHP's 128M default (peak ~140M at 404 tests). -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="prasetya_platform_testing"/>
        <env name="PAYMENT_GATEWAY" value="fake"/>
        <!-- Tests never use a real AI provider, whatever the developer's .env says. -->
        <env name="CONTENT_TEXT_PROVIDER" value="none" force="true"/>
        <env name="CONTENT_TEXT_BASE_URL" value="" force="true"/>
        <env name="CONTENT_TEXT_API_KEY" value="" force="true"/>
        <env name="CONTENT_TEXT_MODEL" value="" force="true"/>
        <env name="CONTENT_TEXT_MODELS" value="" force="true"/>
        <env name="CONTENT_TEXT_PRICE_INPUT" value="0" force="true"/>
        <env name="CONTENT_TEXT_PRICE_OUTPUT" value="0" force="true"/>
        <env name="ADMIN_EMAIL" value=""/>
        <env name="ADMIN_PASSWORD" value=""/>
        <env name="CORS_ALLOWED_ORIGINS" value="https://prasetyawebworks.web.id,https://satamu.prasetyawebworks.web.id"/>
        <env name="APP_LOCALE" value="id"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
